{
  "name": "repo-health-pulse",
  "version": "0.1.0",
  "description": "Repository health vital signs, visualized as a cardiac monitor",
  "bin": {
    "repopulse": "dist-cli/index.js"
  },
  "files": [
    "dist-cli/index.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreahlert/repo-health-pulse.git"
  },
  "homepage": "https://andreahlert.github.io/repo-health-pulse/",
  "scripts": {
    "build:action": "ncc build src/action/index.ts -o dist --minify",
    "build:cli": "ncc build src/cli/index.ts -o dist-cli --minify",
    "build:app": "ncc build src/app/index.ts -o dist-app --minify",
    "build": "npm run build:action && npm run build:cli && npm run build:app",
    "typecheck": "tsc --noEmit",
    "start:app": "node dist-app/index.js"
  },
  "keywords": [
    "github",
    "health",
    "badge",
    "svg",
    "ecg",
    "pulse",
    "monitor",
    "repository",
    "ci",
    "devops"
  ],
  "license": "MIT",
  "author": "andreahlert",
  "devDependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@octokit/rest": "^21.0.0",
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.0",
    "typescript": "^5.5.0"
  }
}
