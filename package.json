{
  "name": "repopulse",
  "version": "0.1.0",
  "description": "Repository health vital signs, visualized as a cardiac monitor",
  "bin": {
    "repopulse": "./dist-cli/index.js"
  },
  "scripts": {
    "build:action": "ncc build src/action/index.ts -o dist --minify",
    "build:cli": "ncc build src/cli/index.ts -o dist-cli --minify",
    "build": "npm run build:action && npm run build:cli",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["github", "health", "badge", "svg", "ecg", "pulse"],
  "license": "MIT",
  "devDependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@octokit/rest": "^21.0.0",
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.0",
    "typescript": "^5.5.0"
  }
}
